<Window x:Class="GoldPriceWatch.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:convert="clr-namespace:GoldPriceWatch.Convert"
        xmlns:controls="clr-namespace:GoldPriceWatch.Controls"
        Title="历史记录" Width="1400" Height="860" MinWidth="1000" MinHeight="640"
        Background="#FFF4F4F6" Foreground="#FF2B2B33"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <convert:ProfitColorConverter x:Key="ProfitColor"/>
        <convert:SideColorConverter x:Key="SideColor"/>

        <Style x:Key="GroupStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFB8860B"/>
            <Setter Property="BorderBrush" Value="#FFD8D8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6E6E78"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF2B2B33"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560" MinWidth="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ 左侧：快照信息 + 交易流水（只读） ═══════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="快照信息" Style="{StaticResource GroupStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="记录名称" Foreground="#FF6E6E78" Margin="0,0,10,6"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,20,6"/>
                    <TextBlock Grid.Column="2" Text="保存时间" Foreground="#FF6E6E78" Margin="0,0,10,6"/>
                    <TextBlock Grid.Column="3" Text="{Binding CreatedAtText}"/>
                    <TextBlock Grid.Row="1" Text="卖出费率 (%)" Foreground="#FF6E6E78" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FeeRatePercent, StringFormat=F2}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="保存时金价" Foreground="#FF6E6E78" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CurrentPrice, StringFormat=F2}"/>
                    <TextBlock Grid.Row="2" Text="克数修正 (克)" Foreground="#FF6E6E78" Margin="0,6,10,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WeightCorrection, StringFormat=F4}" Margin="0,6,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="交易流水" Style="{StaticResource GroupStyle}" Margin="0">
                <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="30"
                          Background="White" Foreground="#FF2B2B33"
                          BorderBrush="#FFD8D8E0" RowBackground="White" AlternatingRowBackground="#FFF6F6F8"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE8E8EE"
                          SelectionMode="Single" FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True"
                          EnableRowVirtualization="True">
                    <DataGrid.Resources>
                        <Style x:Key="CellTextStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF8A2A2A"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFFFF3D6"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE0A83E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFFFF3D6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=MM-dd HH:mm}" Width="Auto" MinWidth="90"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="方向" Binding="{Binding SideText}" Width="Auto" MinWidth="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Side, Converter={StaticResource SideColor}}"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="价格" Binding="{Binding Price, StringFormat=F2}" Width="Auto" MinWidth="70"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="克重" Binding="{Binding Weight, StringFormat=F4}" Width="Auto" MinWidth="80"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=F2}" Width="*"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- ═══════════ 右侧：统计卡片 + 价格走势（只读） ═══════════ -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="保存时金价 (元/克)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CurrentPrice, StringFormat=F2}" Style="{StaticResource StatValue}"
                                   FontSize="26" Foreground="#FFB8860B"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="持仓均价 (元/克)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Summary.AvgCostPrice, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                        <TextBlock FontSize="13" Foreground="#FF8A8A95" Margin="0,4,0,0">
                            <Run Text="{Binding Summary.RemainingWeight, StringFormat=F4}"/><Run Text=" 克"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="持仓成本 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Summary.RemainingCost, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="市值 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Summary.MarketValue, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" MinWidth="190">
                    <StackPanel>
                        <TextBlock Text="浮动盈亏 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Style="{StaticResource StatValue}" FontSize="26"
                                   Foreground="{Binding Summary.FloatingProfit, Converter={StaticResource ProfitColor}}">
                            <Run Text="{Binding Summary.FloatingProfit, StringFormat=F2}"/>
                            <Run FontSize="14" Text="{Binding Summary.FloatingProfitPercent, StringFormat=' ({0:F2}%)'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="保本卖出价 (元/克)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Summary.BreakEvenPrice, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="已实现盈亏 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Summary.NetProfit, StringFormat=F2}" Style="{StaticResource StatValue}"
                                   Foreground="{Binding Summary.NetProfit, Converter={StaticResource ProfitColor}}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <GroupBox Grid.Row="1" Header="价格走势（快照时点）" Style="{StaticResource GroupStyle}" Margin="0" Padding="6">
                <controls:PriceChartControl ItemsSource="{Binding PriceHistory}"
                                            BreakEvenPrice="{Binding Summary.BreakEvenPrice}"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
