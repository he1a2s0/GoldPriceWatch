<Window x:Class="GoldPriceWatch.HoldingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:convert="clr-namespace:GoldPriceWatch.Convert"
        xmlns:controls="clr-namespace:GoldPriceWatch.Controls"
        Title="纸面黄金持仓监控" Width="1920" Height="1080" MinWidth="1240" MinHeight="660"
        Background="#FFF4F4F6" Foreground="#FF2B2B33"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <convert:ProfitColorConverter x:Key="ProfitColor"/>
        <convert:SideColorConverter x:Key="SideColor"/>

        <Style x:Key="GroupStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFB8860B"/>
            <Setter Property="BorderBrush" Value="#FFD8D8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF2B2B33"/>
            <Setter Property="BorderBrush" Value="#FFC6C6D2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#FF2B2B33"/>
        </Style>

        <Style x:Key="InputComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF2B2B33"/>
            <Setter Property="BorderBrush" Value="#FFC6C6D2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="#FFE0A83E"/>
            <Setter Property="Foreground" Value="#FF3B2E10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6E6E78"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF2B2B33"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF4A4A52"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TabBarItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#FF6E6E78"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFB8860B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="600" MinWidth="460" MaxWidth="820"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="6"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition x:Name="RightColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ 左侧：TabControl 分区 ═══════════ -->
        <TabControl x:Name="LeftTabs" Grid.Column="0" TabStripPlacement="Top" Background="Transparent"
                    BorderThickness="0" ClipToBounds="True">

            <!-- ── Tab 1: 交易记录 ── -->
            <TabItem Header="交易记录" Style="{StaticResource TabBarItemStyle}">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 买入/卖出记录（占满所有剩余空间） -->
                    <GroupBox Grid.Row="0" Header="买入 / 卖出记录" Style="{StaticResource GroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 标签与控件共用一个 Grid，列宽只计算一次，保证列首对齐 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="方向" Foreground="#FF8A8A95" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <!-- 11 = TextBox 外距 4 + 边框 1 + 内距 6，保证文字左边缘与输入框文字对齐 -->
                                <TextBlock Grid.Column="1" Text="价格 (元/克)" Foreground="#FF8A8A95" Margin="11,0,0,4" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="总价 (元)" Foreground="#FF8A8A95" Margin="11,0,0,4" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="买入" IsChecked="{Binding NewIsBuy}" Foreground="#FFE84C4C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="卖出" Foreground="#FF2EB86E" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="4,0"
                                         ToolTip="价格 (元/克)"
                                         Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource InputStyle}" Margin="4,0"
                                         ToolTip="总价 (元)"
                                         Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource GoldButton}" Content="添加"
                                        Command="{Binding AddOrderCommand}"/>
                            </Grid>
                            <!-- 行高由 DataGrid.RowHeight 控制；写在单元格模板里 Border 的 Height 不会影响行高 -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      RowHeight="30"
                                      Background="White" Foreground="#FF2B2B33"
                                      BorderBrush="#FFD8D8E0" RowBackground="White" AlternatingRowBackground="#FFF6F6F8"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE8E8EE"
                                      SelectionMode="Single"
                                      FontSize="12"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      EnableRowVirtualization="True">
                                <DataGrid.Resources>
                                    <!-- 单元格内容统一深红色，左右内边距 -->
                                    <Style x:Key="CellTextStyle" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF8A2A2A"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <!-- 单元格内容垂直居中（ContentPresenter 在模板中绑定了 VerticalContentAlignment） -->
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFF3D6"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE0A83E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFFFF3D6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=MM-dd HH:mm}" Width="Auto" MinWidth="90"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="方向" Binding="{Binding SideText}" Width="Auto" MinWidth="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding Side, Converter={StaticResource SideColor}}"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="价格" Binding="{Binding Price, StringFormat=F2}" Width="Auto" MinWidth="70"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="克重" Binding="{Binding Weight, StringFormat=F4}" Width="Auto" MinWidth="80"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=F2}" Width="*"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" FontSize="11" Padding="8,2"
                                                        MinWidth="48" HorizontalAlignment="Stretch"
                                                        Margin="4,0"
                                                        Background="#FFF3DCDC" Foreground="#FF8A2A2A" BorderThickness="0"
                                                        Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 操作按钮：靠右，位于交易记录下方 -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SaveHistoryResultText}"
                                           Visibility="{Binding IsSaveHistoryResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Foreground="#FF2EB86E" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="存为历史记录" Style="{StaticResource GoldButton}"
                                        Command="{Binding SaveCurrentAsHistoryCommand}"/>
                                <Button Content="清空" Margin="10,0,0,0" FontSize="13"
                                        Background="#FFF3DCDC" Foreground="#FF8A2A2A" BorderThickness="0"
                                        Padding="14,6" Cursor="Hand" Click="ClearOrders_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 费率设置（固定在底部） -->
                    <GroupBox Grid.Row="1" Header="费率设置" Style="{StaticResource GroupStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="卖出费率 (%)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Width="80" Style="{StaticResource InputStyle}"
                                     Text="{Binding FeeRatePercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="  买入免手续费，卖出按成交金额收取" Foreground="#FF8A8A95" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ── Tab 2: 监控提醒 ── -->
            <TabItem Header="监控提醒" Style="{StaticResource TabBarItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent">
                    <StackPanel Margin="4,10,4,4">
                        <!-- 刷新设置 -->
                        <GroupBox Header="刷新与通知" Style="{StaticResource GroupStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="刷新间隔 (秒)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Width="70" Style="{StaticResource InputStyle}"
                                             Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                    <CheckBox Content="启用桌面通知" IsChecked="{Binding ShowNotice}"
                                              VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#FF2B2B33"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="立即刷新" Style="{StaticResource GoldButton}" Padding="20,6"
                                            Command="{Binding RefreshNowCommand}"/>
                                    <TextBlock Text="{Binding LastUpdateText}" Foreground="#FF6E6E78" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Foreground="#FFE84C4C" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 绝对价格提醒 -->
                        <GroupBox Header="目标价位提醒" Style="{StaticResource GroupStyle}">
                            <StackPanel>
                                <CheckBox Content="启用价格提醒" IsChecked="{Binding AlertEnabled}"
                                          Foreground="#FF2B2B33" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="高价提醒 (元/克)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Width="120" Style="{StaticResource InputStyle}" Margin="8,0"
                                             Text="{Binding AlertHighPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                    <TextBlock Grid.Column="2" Text="低价提醒 (元/克)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Width="120" Style="{StaticResource InputStyle}" Margin="8,0"
                                             Text="{Binding AlertLowPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                </Grid>
                                <TextBlock Text="0 = 不启用对应方向提醒" Foreground="#FF8A8A95" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 悬浮框 -->
                        <GroupBox Header="悬浮框" Style="{StaticResource GroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="文本透明度" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Width="180" Minimum="30" Maximum="100" VerticalAlignment="Center"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding FloatingOpacityPercent}"/>
                                <TextBlock Text="{Binding FloatingOpacityPercent, StringFormat={}{0:0}%}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="38"/>
                                <TextBlock Text="按住 Ctrl + 滚轮也可直接在悬浮框上调整" Foreground="#FF8A8A95"
                                           FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 卖出/止损目标 -->
                        <GroupBox Header="卖出 / 止损目标价" Style="{StaticResource GroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标卖出价 (元/克)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Width="120" Style="{StaticResource InputStyle}" Margin="8,0"
                                         Text="{Binding TargetSellPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                <TextBlock Grid.Column="2" Text="止损价 (元/克)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="3" Width="120" Style="{StaticResource InputStyle}" Margin="8,0"
                                         Text="{Binding StopLossPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </Grid>
                        </GroupBox>

                        <!-- 降价报警 -->
                        <GroupBox Header="降价报警" Style="{StaticResource GroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="阈值类型" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource InputComboStyle}" Margin="8,0,20,0"
                                          SelectedValue="{Binding DropAlertType, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding AlertThresholdTypeList}"
                                          DisplayMemberPath="Title" SelectedValuePath="Value" MinWidth="120"/>
                                <TextBlock Grid.Column="2" Text="阈值" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="3" Style="{StaticResource InputStyle}" Margin="8,0"
                                         Text="{Binding DropAlertThreshold, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </Grid>
                        </GroupBox>

                        <!-- 涨价提醒 -->
                        <GroupBox Header="涨价提醒" Style="{StaticResource GroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="阈值类型" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource InputComboStyle}" Margin="8,0,20,0"
                                          SelectedValue="{Binding RiseAlertType, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding AlertThresholdTypeList}"
                                          DisplayMemberPath="Title" SelectedValuePath="Value" MinWidth="120"/>
                                <TextBlock Grid.Column="2" Text="阈值" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="3" Style="{StaticResource InputStyle}" Margin="8,0"
                                         Text="{Binding RiseAlertThreshold, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            </Grid>
                        </GroupBox>

                        <!-- 波动率 & 结算 -->
                        <GroupBox Header="其他警报" Style="{StaticResource GroupStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="波动率阈值 (%)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Width="80" Style="{StaticResource InputStyle}"
                                             Text="{Binding VolatilityThreshold, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                    <TextBlock Text="  当日波动超过此值时警报" Foreground="#FF8A8A95" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox Content="启用每日结算价提醒" IsChecked="{Binding EnableSettlementAlert}"
                                          Foreground="#FF2B2B33"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 3: 历史记录 ── -->
            <TabItem Header="历史记录" Style="{StaticResource TabBarItemStyle}">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="历史快照" Style="{StaticResource GroupStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding HistoryRecords}"
                                      SelectedItem="{Binding SelectedHistory}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" RowHeight="30"
                                      Background="White" Foreground="#FF2B2B33"
                                      BorderBrush="#FFD8D8E0" RowBackground="White" AlternatingRowBackground="#FFF6F6F8"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE8E8EE"
                                      SelectionMode="Single" FontSize="12"
                                      MouseDoubleClick="OpenHistory_MouseDoubleClick"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      EnableRowVirtualization="True">
                                <DataGrid.Resources>
                                    <Style x:Key="HistoryCellStyle" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF8A2A2A"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFFFF3D6"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE0A83E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFFFF3D6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="130"
                                                        ElementStyle="{StaticResource HistoryCellStyle}"/>
                                    <DataGridTextColumn Header="保存时间" Binding="{Binding CreatedAtText}" Width="Auto" MinWidth="130"
                                                        ElementStyle="{StaticResource HistoryCellStyle}"/>
                                    <DataGridTextColumn Header="金价" Binding="{Binding CurrentPrice, StringFormat=F2}" Width="Auto" MinWidth="60"
                                                        ElementStyle="{StaticResource HistoryCellStyle}"/>
                                    <DataGridTextColumn Header="持仓 (g)" Binding="{Binding Summary.RemainingWeight, StringFormat=F4}"
                                                        Width="Auto" MinWidth="70"
                                                        ElementStyle="{StaticResource HistoryCellStyle}"/>
                                    <DataGridTextColumn Header="浮盈" Binding="{Binding Summary.FloatingProfit, StringFormat=F2}"
                                                        Width="Auto" MinWidth="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{Binding Summary.FloatingProfit, Converter={StaticResource ProfitColor}}"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="已实现盈亏" Binding="{Binding Summary.NetProfit, StringFormat=F2}"
                                                        Width="Auto" MinWidth="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{Binding Summary.NetProfit, Converter={StaticResource ProfitColor}}"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="流水" Binding="{Binding OrderCount}" Width="Auto" MinWidth="50"
                                                        ElementStyle="{StaticResource HistoryCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1" Margin="4,6,0,0">
                                <TextBlock Text="双击一条记录可查看详情" Foreground="#FF8A8A95" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="查看详情" Style="{StaticResource GoldButton}" Background="#FFF1E4C2"
                                            Click="OpenHistory_Click"/>
                                    <Button Content="删除" Margin="10,0,0,0" FontSize="13"
                                            Background="#FFF3DCDC" Foreground="#FF8A2A2A" BorderThickness="0"
                                            Padding="14,6" Cursor="Hand" Click="DeleteHistory_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- ═══════════ 竖状收起按钮：切换右侧面板显示/隐藏 ═══════════ -->
        <Button x:Name="ToggleRightButton" Grid.Column="2" Width="16" Margin="2,0"
                VerticalAlignment="Stretch" HorizontalAlignment="Center"
                Cursor="Hand" BorderThickness="0" Background="#FFEDEDF2"
                Foreground="#FF8A8A95" FontSize="16" FontWeight="SemiBold" Content="›"
                ToolTip="收起右侧面板" Click="ToggleRight_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF6E8C8"/>
                            <Setter Property="Foreground" Value="#FFB8860B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- ═══════════ 右侧：统计卡片 + 大图表 ═══════════ -->
        <Grid x:Name="RightPanel" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 统计卡片 -->
            <WrapPanel Grid.Row="0" Margin="4,0,0,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="当前金价 (元/克)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CurrentPrice, StringFormat=F2}" Style="{StaticResource StatValue}"
                                   FontSize="26" Foreground="#FFB8860B"/>
                        <TextBlock Style="{StaticResource StatLabel}" FontSize="11">
                            <Run Text="高"/><Run Text="{Binding HighPrice, StringFormat=F2}"/>
                            <Run Text=" 低"/><Run Text="{Binding LowPrice, StringFormat=F2}"/>
                            <Run Text=" 昨结"/><Run Text="{Binding SettlementPrice, StringFormat=F2}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="持仓均价 (元/克)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding AvgCostPrice, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                        <TextBlock FontSize="13" Foreground="#FF8A8A95" Margin="0,4,0,0">
                            <Run Text="{Binding RemainingWeight, StringFormat=F4}"/><Run Text=" 克"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="持仓成本 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RemainingCost, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="当前市值 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding MarketValue, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" MinWidth="190">
                    <StackPanel>
                        <TextBlock Text="浮动盈亏 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Style="{StaticResource StatValue}" FontSize="26"
                                   Foreground="{Binding FloatingProfit, Converter={StaticResource ProfitColor}}">
                            <Run Text="{Binding FloatingProfit, StringFormat=F2}"/>
                            <Run FontSize="14" Text="{Binding FloatingProfitPercent, StringFormat=' ({0:F2}%)'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="保本卖出价 (元/克)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding BreakEvenPrice, StringFormat=F2}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="已实现盈亏 (元)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding NetProfit, StringFormat=F2}" Style="{StaticResource StatValue}"
                                   Foreground="{Binding NetProfit, Converter={StaticResource ProfitColor}}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 价格走势图表（占据剩余全部空间） -->
            <GroupBox Grid.Row="1" Header="价格走势" Style="{StaticResource GroupStyle}" Margin="4,0,0,0" Padding="6">
                <controls:PriceChartControl ItemsSource="{Binding PriceHistory}"
                                            BreakEvenPrice="{Binding BreakEvenPrice}"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
