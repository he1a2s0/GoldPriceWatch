<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 逐显示器 DPI 感知：见 app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFAC010：WinForms 分析器建议改用 ApplicationHighDpiMode 配置 DPI。
      本项目是 WPF 应用（WinForms 仅用于托盘 NotifyIcon），不会调用
      ApplicationConfiguration.Initialize()，因此 DPI 感知只能通过清单声明。
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- 托盘图标依赖 WinForms；移除其隐式全局 using 以避开与 WPF 的类型冲突（Point/Color/Application 等） -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Flurl" Version="4.0.0" />
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="Flurl.Http.Newtonsoft" Version="0.9.1" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Masuit.Tools.Core" Version="2025.5.2" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

</Project>
